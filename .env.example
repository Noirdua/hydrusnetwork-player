# Optional same-origin proxy when this app is HTTPS and Hydrus is HTTP.
# In Settings, add a server with URL /hydrus-proxy plus your API key there.
# Example: HYDRUS_PROXY_TARGET=http://192.168.1.50:45869
HYDRUS_PROXY_TARGET=

# Thorium Web sidecar used to read EPUB files. Default is http://localhost:3000
VITE_THORIUM_WEB_URL=http://localhost:3000
